<% layout("/layouts/boilerplate") %>

<div class="edit-listing-page">
  <div class="edit-listing-card">
    <h1>Edit your Listing</h1>
    <p class="form-subtitle">Update the details of your property.</p>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data">

      <div class="form-group">
        <label for="title">Title</label>
        <input
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          required
        />
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea
          id="description"
          name="listing[description]"
          rows="4"
          required
        ><%= listing.description %></textarea>
      </div>

      <div class="form-group">
        <label>Current Image</label>
        <div class="current-image-preview">
          <img
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://thumbs.dreamstime.com/b/default-image-icon-vector-missing-picture-page-website-design-mobile-app-no-photo-available-236105299.jpg' %>"
            alt="Current image for <%= listing.title %>"
          />
        </div>
      </div>

      <div class="form-group">
        <label for="image">Replace Image <span>(optional)</span></label>
        <input
          id="image"
          name="image"
          type="file"
          accept="image/*"
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="price">Price</label>
          <input
            id="price"
            name="listing[price]"
            value="<%= listing.price %>"
            type="number"
            required
          />
        </div>

        <div class="form-group">
          <label for="country">Country</label>
          <input
            id="country"
            name="listing[country]"
            value="<%= listing.country %>"
            type="text"
            required
          />
        </div>
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text"
          required
        />
      </div>

      <div class="form-group">
        <label for="category">Category</label>
        <select id="category" name="listing[category]" required>
          <option value="beach" <%= listing.category === "beach" ? "selected" : "" %>>Beach</option>
          <option value="mountains" <%= listing.category === "mountains" ? "selected" : "" %>>Mountains</option>
          <option value="city" <%= listing.category === "city" ? "selected" : "" %>>City</option>
          <option value="cabins" <%= listing.category === "cabins" ? "selected" : "" %>>Cabins</option>
          <option value="historic" <%= listing.category === "historic" ? "selected" : "" %>>Historic</option>
          <option value="nature" <%= listing.category === "nature" ? "selected" : "" %>>Nature</option>
        </select>
      </div>

      <button class="edit-listing-btn" type="submit">Save Changes</button>
    </form>
  </div>
</div>
